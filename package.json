{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "release": "yarn build && changeset publish",
    "changeset": "changeset",
    "prepare": "husky",
    "watch:shared": "turbo watch build --filter='./packages/*'",
    "_dev:concurrent": "yarn dev:clean && concurrently -n watch,frontend -c blue,green --kill-others-on-fail \"yarn watch:shared\" \"yarn workspace @openvaa/frontend dev\"",
    "dev": "yarn db:start && yarn _dev:concurrent",
    "dev:clean": "yarn workspace @openvaa/frontend clean",
    "dev:reset": "yarn db:reset && yarn dev",
    "dev:reset-with-data": "yarn db:reset-with-data && yarn dev",
    "db:start": "yarn workspace @openvaa/supabase start",
    "db:stop": "yarn workspace @openvaa/supabase stop",
    "db:status": "yarn workspace @openvaa/supabase status",
    "db:reset": "yarn db:start && yarn workspace @openvaa/supabase reset",
    "db:reset-with-data": "yarn db:reset && yarn db:seed:default",
    "db:reset-with-e2e-data": "yarn db:reset-with-data --template e2e/base",
    "db:seed": "yarn workspace @openvaa/dev-seed seed",
    "db:seed:default": "yarn db:seed --template default",
    "db:seed:teardown": "yarn workspace @openvaa/dev-seed seed:teardown",
    "db:types": "yarn workspace @openvaa/supabase-types generate",
    "db:lint:sql": "yarn workspace @openvaa/supabase lint:all",
    "assert:unit-coverage": "node scripts/assert-unit-test-coverage.mjs",
    "assert:i18n-catalog-namespaces": "node scripts/assert-i18n-catalog-namespaces.mjs",
    "assert:a11y-scan-wiring": "node scripts/assert-a11y-scan-wiring.mjs",
    "assert:rpc-nullability": "node scripts/assert-rpc-return-nullability.mjs",
    "assert:comment-hygiene": "node scripts/assert-comment-hygiene.mjs",
    "assert:edge-env-defaults": "node scripts/assert-edge-env-defaults.mjs",
    "assert:declared-binaries": "node scripts/assert-declared-binaries.mjs",
    "assert:node-engine": "node scripts/assert-node-engine.mjs",
    "assert:env-pair-registry": "node scripts/assert-env-pair-registry.mjs",
    "assert:schema-migration-parity": "node scripts/assert-schema-migration-parity.mjs",
    "assert:schema-migration-parity:update": "node scripts/assert-schema-migration-parity.mjs --update",
    "assert:adapter-casts": "node scripts/assert-adapter-casts.mjs",
    "audit:deps": "node scripts/assert-dependency-audit.mjs",
    "assert:cookie-names": "node scripts/assert-cookie-names.mjs",
    "assert:no-session-in-loads": "node scripts/assert-no-session-in-loads.mjs",
    "check:env-pairs-agree": "node scripts/assert-env-pairs-agree.mjs",
    "preinstall": "node scripts/assert-node-engine.mjs",
    "test:unit": "yarn assert:unit-coverage && turbo run test:unit",
    "test:unit:watch": "echo '###################################\nNB! Running only tests in /packages\n###################################\n' && vitest",
    "test:e2e": "yarn assert:i18n-catalog-namespaces && yarn assert:a11y-scan-wiring && playwright test -c ./tests/playwright.config.ts ./tests --grep-invert @probe",
    "test:e2e:probes": "playwright test -c ./tests/playwright.config.ts --project=_probes",
    "format": "turbo run build --filter=@openvaa/app-shared... && prettier --write . && yarn workspace @openvaa/docs format",
    "format:check": "turbo run build --filter=@openvaa/app-shared... && prettier --check . && yarn workspace @openvaa/docs format:check",
    "lint:fix": "turbo run lint -- --fix && eslint --flag v10_config_lookup_from_file --fix tests",
    "lint:check": "turbo run lint && eslint --flag v10_config_lookup_from_file tests && yarn typecheck:tests && yarn typecheck && yarn assert:i18n-catalog-namespaces && yarn assert:a11y-scan-wiring && yarn assert:comment-hygiene && yarn assert:edge-env-defaults && yarn assert:declared-binaries && yarn assert:node-engine && yarn assert:env-pair-registry && yarn assert:schema-migration-parity && yarn assert:adapter-casts && yarn assert:cookie-names && yarn assert:no-session-in-loads && yarn assert:rpc-nullability",
    "typecheck": "turbo run typecheck",
    "typecheck:tests": "node_modules/.bin/tsc -p tests/tsconfig.json --noEmit",
    "docs:prepare": "turbo run build --filter='./packages/*' && yarn workspace @openvaa/frontend prepare",
    "docs:generate": "yarn workspace @openvaa/docs generate",
    "docs:typedoc": "yarn workspace @openvaa/docs generate:typedoc",
    "docs:typedoc-frontend": "yarn workspace @openvaa/docs generate:typedoc-frontend",
    "docs:components": "yarn workspace @openvaa/docs generate:components",
    "docs:routes": "yarn workspace @openvaa/docs generate:routes",
    "docs:dev": "yarn workspace @openvaa/docs dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@faker-js/faker": "catalog:",
    "@openvaa/dev-seed": "workspace:^",
    "@openvaa/shared-config": "workspace:^",
    "@openvaa/supabase-types": "workspace:^",
    "@playwright/test": "catalog:",
    "@supabase/supabase-js": "^2.99.3",
    "@types/cheerio": "^0.22.35",
    "@types/node": "catalog:",
    "cheerio": "^1.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-playwright": "^2.9.0",
    "eslint-plugin-simple-import-sort": "catalog:",
    "glob": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.8.17",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "yarn": "4.13",
    "npm": "please-use-yarn"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "yarn@4.13.0",
  "resolutions": {
    "isomorphic-dompurify/jsdom": "^26.1.0"
  }
}
