################################################################
# Cross-runtime environment pairs
################################################################

# Four variables exist TWICE, once per runtime, and the two spellings of each MUST HOLD THE SAME
# VALUE. The Deno Edge Functions under `apps/supabase/supabase/functions` read the un-prefixed
# name; the SvelteKit frontend under `apps/frontend/src` reads the `PUBLIC_`-prefixed name, because
# Vite exposes only prefixed variables to the client bundle.
#
# Neither spelling is redundant and they are deliberately NOT consolidated. The Supabase Edge
# runtime injects `SUPABASE_URL` and `SUPABASE_ANON_KEY` into deployed functions automatically, so
# reading the `PUBLIC_` twin there would mean configuring what the platform already provides. And
# `PUBLIC_` is a BUNDLING CONTRACT meaning "embedded in client JavaScript", not a naming
# convention: reusing it in a server-only runtime, where it means nothing, erodes the only
# browser-safety signal a reviewer has. Do not consolidate them.
#
# `node scripts/assert-env-pair-registry.mjs` (a link of `yarn lint:check`) derives this pair set
# from source and fails if a new twin appears without an entry in this block; it cannot see values.
# `node scripts/assert-env-pairs-agree.mjs <env-file>` compares the VALUES of these pairs in an env
# file it is handed. Keep each pair's two members adjacent and this block contiguous -- the
# registry guard asserts both. See
# `.planning/phases/153-build-tooling-config-correctness/153-ENV-PAIRS.md` for what neither can see.

# Supabase API origin. Injected automatically by the Edge runtime in deployment; set here because
# the opt-in bank-auth E2E specs read the un-prefixed name from the root env file.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Anon (publishable) key for the local Supabase stack.
# Get it with: yarn workspace @openvaa/supabase supabase status -o env
# Injected automatically by the Edge runtime in deployment; the un-prefixed name is set here
# because the opt-in bank-auth E2E specs read it and throw at module load without it.
PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# OIDC client identifier for the active provider.
# Signicat: from https://dashboard.signicat.com/oidc-clients/
# Idura: the application URN (e.g., urn:my:application:identifier:498295)
# `identity-callback` verifies the un-prefixed value as the expected `aud` and throws when it is
# unset -- an unbound audience accepts a token minted by another issuer for a different party.
PUBLIC_IDENTITY_PROVIDER_CLIENT_ID=client_id
IDENTITY_PROVIDER_CLIENT_ID=client_id

# Provider type: 'signicat' or 'idura'. Selects the provider claim mapping in `identity-callback`,
# which throws when the un-prefixed name is unset.
PUBLIC_IDENTITY_PROVIDER_TYPE=signicat
IDENTITY_PROVIDER_TYPE=signicat

################################################################
# Service-role key (server-side tooling only)
################################################################

# The local stack's service_role key. It BYPASSES ROW-LEVEL SECURITY entirely, so it is deliberately
# NOT part of the cross-runtime pair block above and must never gain a `PUBLIC_` twin: that prefix is
# a bundling contract meaning "embedded in client JavaScript", and this key must never reach a
# browser. Nothing under `apps/frontend/src` reads it; only local tooling and the test harness do.
# Get it with: yarn workspace @openvaa/supabase supabase status -o env
#
# Required by, and each of these fails loudly rather than silently degrading when it is unset:
#   - `yarn db:seed` (and `yarn db:reset-with-data`) -- @openvaa/dev-seed's `Writer` throws at
#     construction: "SUPABASE_SERVICE_ROLE_KEY env var is required but not set."
#   - `tests/scripts/e2e-run.sh` -- exits 4 before the run starts, because the public-assets
#     readiness assertion cannot run without it and skipping that silently wedges an unattended batch.
#   - the opt-in bank-auth E2E specs (`PLAYWRIGHT_BANK_AUTH`) -- throw at module load.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

################################################################
# Project scoping
################################################################

# The project every query this deployment issues is scoped to. The value below is the default
# project created by `apps/supabase/supabase/seed.sql`. There is no fallback in application code:
# an unset or malformed value makes the Supabase adapter throw at construction rather than quietly
# read some other project's rows. The identity-callback Edge Function reads this same variable, under
# this same name, to decide which project a self-registered candidate is assigned to; a request that
# names a different project is refused rather than honoured.
PUBLIC_PROJECT_ID=00000000-0000-0000-0000-000000000001

# Read only by the E2E harness, which carries this same value as a committed default -- so the line
# below is an OVERRIDE, not a requirement, and is deliberately left commented out. The harness
# passes whatever it resolves to the dev server as PUBLIC_PROJECT_ID. It must never equal
# PUBLIC_PROJECT_ID's default above: the whole point is a second project the suite owns.
#
# KEEP IT COMMENTED OUT. The dev-seed CLI loads this file through `process.loadEnvFile` and the
# Playwright config loads it through `dotenv.config()`, so a live line here would silently re-point
# `yarn db:seed:default` -- and therefore `yarn db:reset-with-data` -- at the E2E project, leaving a
# plain local dev session showing an empty app.
# E2E_PROJECT_ID=00000000-0000-0000-0000-0000000000e2

################################################################
# Frontend configuration
################################################################

PUBLIC_BROWSER_FRONTEND_URL=http://localhost:5173
PUBLIC_SERVER_FRONTEND_URL=http://localhost:5173

FRONTEND_PORT=5173

################################################################
# Cache settings
################################################################

PUBLIC_CACHE_ENABLED=false
CACHE_DIR=/var/data/cache
CACHE_TTL=86400000
CACHE_LRU_SIZE=1000
CACHE_EXPIRATION_INTERVAL=3600000

################################################################
# Local data adapter (optional)
################################################################

LOCAL_DATA_DIR=/var/data/local

################################################################
# Identity Provider Configuration
################################################################

# ⚠ THIS FILE IS NOT ENOUGH ON ITS OWN. The local Supabase edge runtime does NOT inherit this file,
# so every variable below that an Edge Function reads must ALSO reach the functions' own
# environment. `identity-callback` requires seven un-prefixed variables and `send-email` three more;
# each is read through `requireEnv` / `requireVerifyClaimBinding` and throws
# `ERR_ENV_UNCONFIGURED` at request time, whereupon the function returns HTTP 500 with the fixed
# literal `{"error":"Internal server error"}` -- naming nothing, deliberately, because the endpoint
# is served `--no-verify-jwt`. The variable name appears ONLY in the container log. Two options:
#
#   A. Serve the function against THIS file (one copy of your keys; needs a second terminal):
#        cd apps/supabase/supabase
#        npx supabase functions serve identity-callback --no-verify-jwt --env-file ../../../.env
#
#   B. Copy the template beside the functions and fill it in, then restart the stack so the
#      container picks it up (`yarn db:stop && yarn db:start` -- a running edge runtime keeps the
#      environment it booted with):
#        cp apps/supabase/supabase/functions/.env.example apps/supabase/supabase/functions/.env
#
# `apps/supabase/supabase/functions/.env.example` lists exactly what that file needs and where each
# value comes from; `yarn assert:edge-function-env <path>` checks a real one against what the
# functions actually require, deriving the list from their source rather than from a transcript of
# it. Both print variable NAMES only. See `tests/IDURA-TEST-RUNBOOK.md` § Step 3.

# The two variables that are cross-runtime pairs -- PUBLIC_IDENTITY_PROVIDER_TYPE and
# PUBLIC_IDENTITY_PROVIDER_CLIENT_ID, each with an un-prefixed twin -- live in the cross-runtime
# pair block at the top of this file, beside their twins.

# --- Shared vars (set to the active provider's values) ---
#
# READ THIS BEFORE COPYING. The three variables in this block are read by BOTH providers under the
# same names, so there is no `PUBLIC_IDENTITY_PROVIDER_TYPE`-driven branch to keep them honest: a
# value left over from the other provider is syntactically fine, passes every presence check, and
# fails only at runtime. Two of them shipped here as live Signicat sandbox URLs for the repo's whole
# life, which cost one debug session (`.planning/debug/idura-bank-auth-empty-client.md`): switching
# to Idura sets the Idura-specific block below and leaves these two pointing at Signicat, so the
# signature-JWKS fetch 404s and, once that is fixed, the issuer comparison mismatches.
#
# They are placeholders now. Take the two URL values from the ACTIVE provider's own live
# `.well-known/openid-configuration` document rather than from the shapes named below — the shapes
# are a sanity check, not a source of truth. Idura's real `jwks_uri` was measured as
# `/.well-known/jwks`, NOT the `/.well-known/openid-configuration/jwks` this file used to document.

# Private decryption JWKS (JSON array) for decrypting JWE id_tokens
# See docs/key-generation.md for generation instructions
IDENTITY_PROVIDER_DECRYPTION_JWKS='[{"kty":"RSA","kid":"{key_id}","use":"enc","alg":"RSA-OAEP","e":"{secret}","n":"{secret}","d":"{secret}","p":"{secret}","q":"{secret}","dp":"{secret}","dq":"{secret}","qi":"{secret}"}]'

# JWKS endpoint for verifying signed id_tokens. Take it from the active provider's live
# `.well-known/openid-configuration` -> `jwks_uri`, verbatim.
#   Signicat: .../auth/open/.well-known/openid-configuration/jwks
#   Idura:    https://{IDURA_DOMAIN}/.well-known/jwks   <- measured against a live tenant
# It must name the URL that serves the key set DIRECTLY. jose requests it with `redirect: 'manual'`,
# so a 3xx is delivered as a non-200 and is NOT followed: a redirecting URL fails exactly like a 404.
IDENTITY_PROVIDER_JWKS_URI=<active-provider-jwks-uri>

# JWT issuer for id_token verification. Also from the live `.well-known/openid-configuration`, its
# `issuer` field, verbatim -- this is compared against the id_token's `iss` claim.
#   Signicat: https://{tenant}.signicat.com/auth/open
#   Idura:    https://{IDURA_DOMAIN}   (no path suffix)
# A WRONG value here is worse than a missing one in one specific way: jose compares the issuer only
# under `if (issuer && ...)`, so an EMPTY string would accept any token signed by a key in the
# configured set, including one minted for a different relying party. `decryptAndVerifyIdToken.ts`
# therefore fails closed when it is unset -- but a stale non-empty value simply mismatches, which is
# the failure you want to recognise rather than debug twice.
IDENTITY_PROVIDER_ISSUER=<active-provider-issuer>

# --- Signicat-specific (only when PUBLIC_IDENTITY_PROVIDER_TYPE=signicat) ---

# Authorization endpoint for client-side PKCE redirect
# Source: https://openvaa.sandbox.signicat.com/auth/open/.well-known/openid-configuration
PUBLIC_IDENTITY_PROVIDER_AUTHORIZATION_ENDPOINT=https://openvaa.sandbox.signicat.com/auth/open/connect/authorize

# Token endpoint for authorization code exchange
IDENTITY_PROVIDER_TOKEN_ENDPOINT=https://openvaa.sandbox.signicat.com/auth/open/connect/token

# Client secret for Signicat token exchange
# Source: https://dashboard.signicat.com/oidc-clients/clientdetails/{client_id}/secrets
IDENTITY_PROVIDER_CLIENT_SECRET=client_secret

# --- Idura-specific (only when PUBLIC_IDENTITY_PROVIDER_TYPE=idura) ---

# Domain for Idura broker (e.g., openvaa.test.idura.broker)
IDURA_DOMAIN=your-subdomain.idura.broker

# Private signing JWKS (JSON array) for JAR + private_key_jwt client authentication
# See docs/key-generation.md for generation instructions
IDURA_SIGNING_JWKS='[{"kty":"RSA","kid":"openvaa-signing-1","use":"sig","alg":"RS256","n":"{secret}","e":"{secret}","d":"{secret}","p":"{secret}","q":"{secret}","dp":"{secret}","dq":"{secret}","qi":"{secret}"}]'

# KID of the signing key to use from IDURA_SIGNING_JWKS
IDURA_SIGNING_KEY_KID=openvaa-signing-1

################################################################
# Supabase Edge Function configuration (un-prefixed, single-source)
################################################################

# These are read ONLY by the Deno Edge Functions and have no frontend twin, so they are not
# cross-runtime pairs and the registry guard derives nothing from them. The two Edge variables that
# DO have a PUBLIC_ twin (IDENTITY_PROVIDER_TYPE, IDENTITY_PROVIDER_CLIENT_ID) live in the
# cross-runtime pair block at the top of this file. PUBLIC_PROJECT_ID is in neither category and is
# not repeated here: it is ONE name read by both runtimes, and it lives in the Project scoping
# section above.
# Every variable in this block throws when unset (Phase 155, REVIEW-EDGE-02 / REVIEW-EDGE-05).
# IDENTITY_PROVIDER_ISSUER, IDENTITY_PROVIDER_JWKS_URI and IDENTITY_PROVIDER_DECRYPTION_JWKS are
# also un-prefixed and single-source; they live in the Identity Provider section above and are
# equally required.

# identity-callback and invite-candidate: origin used to build post-login redirects and invite
# links. Throws when unset; the fallbacks it replaces pointed at localhost and at SUPABASE_URL.
SITE_URL=http://127.0.0.1:5173

# send-email: local mail catcher (Inbucket). Each of the three throws when unset.
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_FROM=noreply@openvaa.org

################################################################
# LLM settings (Admin App)
################################################################

LLM_OPENAI_API_KEY=""

################################################################
# Debugging
################################################################

PUBLIC_DEBUG=false

# Minimum level the shared structured logger emits, applied identically in the browser and the SSR
# module graph. Accepted values: debug, info, warn, error. Unset falls back to warn -- or to debug in
# a dev build or when PUBLIC_DEBUG=true, so an explicit value here always wins.
#
# Anything outside that set -- INCLUDING the word `silent` -- emits one error record naming the value
# and then falls back, rather than preventing the app booting. `silent` is rejected on purpose:
# accepting it would let one variable reintroduce production log silence with no signal at all, which
# is the defect this variable exists to close.
#
# NO un-prefixed twin, by design. The Deno Edge Functions do not read a log level, so this is not a
# cross-runtime pair; adding an un-prefixed twin alongside it would make it one and pull it into the
# registry block at the top of this file.
PUBLIC_LOG_LEVEL=warn
