{
  "results": {
    "alliance": {
      "numShown": [
        {
          "declarations": ["input numShown"],
          "selectors": ["numShown"],
          "match": {
            "numShown=0": "Ingen alliancer",
            "numShown=1": "1 alliance",
            "numShown=*": "{numShown} alliancer"
          }
        }
      ],
      "summary": {
        "template": "{candidates} på tværs af {parties}",
        "candidates": [
          {
            "declarations": ["input numCandidates", "local numCandidatesPlural = numCandidates: plural"],
            "selectors": ["numCandidates", "numCandidatesPlural"],
            "match": {
              "numCandidates=0, numCandidatesPlural=*": "Ingen kandidater",
              "numCandidates=*, numCandidatesPlural=one": "1 kandidat",
              "numCandidates=*, numCandidatesPlural=*": "{numCandidates} kandidater"
            }
          }
        ],
        "parties": [
          {
            "declarations": ["input numParties", "local numPartiesPlural = numParties: plural"],
            "selectors": ["numParties", "numPartiesPlural"],
            "match": {
              "numParties=0, numPartiesPlural=*": "ingen partier",
              "numParties=*, numPartiesPlural=one": "1 parti",
              "numParties=*, numPartiesPlural=*": "{numParties} partier"
            }
          }
        ]
      }
    },
    "candidate": {
      "numShown": [
        {
          "declarations": ["input numShown"],
          "selectors": ["numShown"],
