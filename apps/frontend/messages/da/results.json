            "numShown=0": "Ingen kandidater",
            "numShown=1": "1 kandidat",
            "numShown=*": "{numShown} kandidater"
          }
        }
      ]
    },
    "faction": {
      "numShown": [
        {
          "declarations": ["input numShown"],
          "selectors": ["numShown"],
