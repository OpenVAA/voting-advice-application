################################################################
# Edge Function environment — apps/supabase/supabase/functions/.env
################################################################
#
# THIS IS A SECOND, SEPARATE ENV FILE, AND IT IS NOT OPTIONAL. The local Supabase edge runtime does
# NOT inherit the repo-root `.env`. Copy this file to `.env` beside it and fill in the values:
#
#     cp apps/supabase/supabase/functions/.env.example apps/supabase/supabase/functions/.env
#
# Then restart the stack so the container picks it up -- `yarn db:stop && yarn db:start`. An
# already-running edge runtime keeps the environment it booted with, so editing this file while the
# container is up changes nothing.
#
# The alternative, if you would rather keep ONE copy of your private keys, is to skip this file and
# serve the function against the root env file instead (this is what `tests/IDURA-TEST-RUNBOOK.md`
# § Step 3 calls Option A):
#
#     cd apps/supabase/supabase
#     npx supabase functions serve identity-callback --no-verify-jwt --env-file ../../../.env
#
# Either way, the un-prefixed spellings below must be present and must agree with their `PUBLIC_`
# twins in the root `.env`. `yarn check:env-pairs-agree <file>` compares the twins;
# `yarn assert:edge-function-env <file>` checks this file against what the functions actually
# require. Both print variable NAMES only, never values.
#
# WHY GETTING THIS WRONG IS EXPENSIVE. Every variable below is read through `requireEnv` or
# `requireVerifyClaimBinding`, which throw `ERR_ENV_UNCONFIGURED` at request time. The function then
# returns HTTP 500 with the fixed literal `{"error":"Internal server error"}` -- naming nothing,
# deliberately, because the endpoint is served `--no-verify-jwt` and must not tell an
# unauthenticated caller which parts of the deployment are unconfigured. The variable name appears
# ONLY in the container log. A 500 from this function means "look at the logs"; a 401 means the
# token itself was rejected. See `.planning/debug/idura-bank-auth-empty-client.md`.
#
# `scripts/assert-edge-function-env.mjs` (wired into `yarn lint:check`) derives the required set
# from the function sources and fails if this template stops declaring one of them, so this list
# cannot silently fall behind the code.
#
# NOT LISTED HERE, ON PURPOSE: `SUPABASE_URL` and `SUPABASE_SERVICE_ROLE_KEY`. The edge runtime
# injects both automatically, so setting them here is redundant at best and stale at worst.

################################################################
# Identity provider — read by identity-callback
################################################################

# Which provider's claim mapping to apply: `idura` or `signicat`.
# This is the un-prefixed twin of PUBLIC_IDENTITY_PROVIDER_TYPE in the root `.env`; the two MUST
# hold the same value. The frontend reads the PUBLIC_ name (Vite exposes only prefixed variables to
# the client bundle); this function reads the un-prefixed one.
IDENTITY_PROVIDER_TYPE=idura

# Private decryption JWKS (JSON array) for decrypting the JWE id_token.
# Same value as the root `.env`'s IDENTITY_PROVIDER_DECRYPTION_JWKS. See docs/key-generation.md.
IDENTITY_PROVIDER_DECRYPTION_JWKS=<private-encryption-jwk-array>

# JWKS endpoint for verifying the signed id_token. Take it from the ACTIVE provider's live
# `.well-known/openid-configuration` -> `jwks_uri`, verbatim.
#   Idura:    https://{IDURA_DOMAIN}/.well-known/jwks   <- measured; NOT .../openid-configuration/jwks
#   Signicat: .../auth/open/.well-known/openid-configuration/jwks
# It must name the URL that serves the key set DIRECTLY: the key set is fetched with
# `redirect: 'manual'`, so a 3xx is delivered as a non-200 and is NOT followed -- a redirecting URL
# fails exactly like a 404.
IDENTITY_PROVIDER_JWKS_URI=<active-provider-jwks-uri>

# Expected `aud` on the id_token -- your provider application's client id (for Idura, the
# application URN, e.g. urn:my:application:identifier:498295).
# Un-prefixed twin of PUBLIC_IDENTITY_PROVIDER_CLIENT_ID. THE TWO MUST AGREE: the frontend mints the
# authorization request with the PUBLIC_ value, and this function verifies the un-prefixed value as
# the expected audience, so a drift between them fails the round trip at this function with a 401
# even though the redirect to the provider worked perfectly.
IDENTITY_PROVIDER_CLIENT_ID=<provider-client-id>

# Expected `iss` on the id_token, from the live `.well-known/openid-configuration` -> `issuer`.
#   Idura:    https://{IDURA_DOMAIN}   (no path suffix)
#   Signicat: https://{tenant}.signicat.com/auth/open
IDENTITY_PROVIDER_ISSUER=<active-provider-issuer>

################################################################
# Project + site — read by identity-callback and send-email
################################################################

# The project a self-registered candidate is assigned to. One name, shared with the frontend --
# a deployment configured under the earlier DEFAULT_PROJECT_ID must rename that secret, because the
# function throws when PUBLIC_PROJECT_ID is unset and no longer reads the old name.
# The local default below is the project `apps/supabase/supabase/seed.sql` creates.
PUBLIC_PROJECT_ID=00000000-0000-0000-0000-000000000001

# The site origin candidate links are addressed to. Must match `config.toml` `[auth].site_url`.
# There is deliberately no fallback: this used to fall back to the Supabase API host, which produced
# invite links at the API origin that no recipient could use, from a deployment reporting no error.
SITE_URL=http://127.0.0.1:5173

################################################################
# SMTP — read by send-email
################################################################

# For a local stack these are Inbucket's, matching `config.toml`. SMTP_USER and SMTP_PASS are read
# unguarded (local Inbucket needs no auth) and so are absent from the required set -- set them for
# any real SMTP server.
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_FROM=noreply@openvaa.org
