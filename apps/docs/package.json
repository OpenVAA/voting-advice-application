{
  "name": "@openvaa/docs",
  "description": "OpenVAA Documentation Site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "lint": "eslint .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:full": "prettier --check . && eslint .",
    "generate:docs": "tsx scripts/generate-all-docs-and-validate.ts && yarn format",
    "generate:component-docs": "tsx scripts/generate-component-docs.ts",
    "generate:navigation": "tsx scripts/generate-navigation-config.ts",
    "generate:route-map": "tsx scripts/generate-route-map.ts",
    "validate:links": "tsx scripts/validate-links.ts",
    "check:research-quotes": "tsx scripts/check-research-quotes.ts"
  },
  "dependencies": {
    "@openvaa/app-shared": "workspace:^"
  },
  "devDependencies": {
    "@openvaa/shared-config": "workspace:^",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "^4.0.15",
    "daisyui": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "glob": "^11.0.0",
    "mdsvex": "^0.12.6",
    "playwright": "^1.63.0",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "rehype-slug": "^6.0.0",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.2.6",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.15"
  }
}
