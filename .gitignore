.idea/
.DS_STORE
.env
!.env.example
node_modules

# Private keys and certificates (JWKS sources, signing/encryption keys, etc.)
*.pem
*.key
*.p12
*.pfx
# TEST-ONLY self-signed localhost cert/key for the bank-auth-journey mock OIDC
# issuer (EFLOW-10b). CN=127.0.0.1, never installed into a trust store, never used
# by production (threat T-122-09, accepted). Intentionally tracked so the SAME cert
# is shared across machines/CI for the opt-in PLAYWRIGHT_BANK_AUTH journey run.
!tests/tests/support/mock-oidc-cert.pem
!tests/tests/support/mock-oidc-key.pem

# Claude Code local settings
.claude/*.local.json

# Turborepo
.turbo

# TypeScript incremental-build state. Regenerated by every compile — machine-local and never
# shared. The canonical package shape points `tsBuildInfoFile` into the already-ignored `dist/`
# (packages/README.md); this rule catches every workspace that does not, so the class of tracked
# build artefacts cannot reopen in a workspace that omits the setting.
*.tsbuildinfo

# Yarn 4 without Zero-installs
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
test-results/

# Playwright test artifacts (HTML report + outputDir + ad-hoc config dumps)
playwright-report/
playwright-results/
raw.json
tests/.planning/

# GSD per-session milestone lock (pid + session id, rewritten on every run — machine-local)
.planning/milestone.lock

# Phase 138 per-run E2E evidence dirs (tests/scripts/e2e-run.sh). Raw dev-server logs,
# per-run HTML reports and traces live here and are NEVER committed; only the derived,
# reviewed per-run table under .planning/ is.
tests/e2e-runs/

# Supabase Studio scratch (auto-named "Untitled query NNN.sql" — local dev only)
apps/supabase/supabase/snippets/

# Supabase CLI local state (rewritten on every CLI run — machine-local, never shared)
supabase/.branches/
supabase/.temp/

# Claude Code harness state (scheduled-task lock file)
.claude/scheduled_tasks.lock

# Executable copies of the project-scoped query guard. The gate spec writes mutated and
# deliberately-broken copies BESIDE the guard — the guard resolves the shared comment classifier
# and the repository root relative to its own location, so a copy anywhere else fails for reasons
# that have nothing to do with what is under test — and removes each one in a finally block. These
# entries are the backstop: a run that dies before its cleanup would otherwise leave a runnable
# script in the tree that no gate reads and anybody can commit.
scripts/.vacuity-probe-*.mjs
scripts/.boundary-vacuity-probe-*.mjs
scripts/.cell-mutation-probe-*.mjs

# ── GSD baseline (auto-generated) ──
.gsd
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/*
*.code-workspace
.env.*

# RE-ASSERTED AFTER `.env.*`, DELIBERATELY. Git applies these patterns in order, so the
# `!.env.example` on line 4 is undone by the `.env.*` above — which silently re-ignored EVERY
# `.env.example` in the tree. The root one survived only because it was already tracked, and
# gitignore does not affect tracked files; a NEW template (for example
# `apps/supabase/supabase/functions/.env.example`, which `scripts/assert-edge-function-env.mjs`
# requires) was invisible to `git add` with no error. No slash, so this matches at any depth.
!.env.example
!.env.sample
!.env.template

node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log
coverage/
.cache/
tmp/

# Terraform. State and plan files hold secrets in clear text (passwords, keys, tokens), so none
# of them may ever be committed. This block stays at the end of the file: Git applies patterns in
# order and a later negation must not be able to undo it.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.*.log
*.tfplan
tfplan
tfplan.*
# `terraform.tfvars` in each root is tracked on purpose: it is the public record of the root's
# non-secret inputs and holds no secret. Only local and secret variable files are ignored.
*.auto.tfvars
*.auto.tfvars.json
*.local.tfvars
*.secret.tfvars
# Local overrides, including the backend override used for the first apply of the bootstrap
# root, and per-user CLI configuration.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# A provider lock file belongs to a root and never to a module.
infra/modules/**/.terraform.lock.hcl
