{
  "private": true,
  "name": "@openvaa/question-info",
  "version": "0.1.0",
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist && mkdir -p dist/prompts && cp -R src/prompts/* dist/prompts/",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit --composite false",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js"
  },
  "devDependencies": {
    "@openvaa/shared-config": "workspace:^",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@openvaa/core": "workspace:^",
    "@openvaa/data": "workspace:^",
    "@openvaa/llm": "workspace:^",
    "zod": "catalog:"
  }
}
